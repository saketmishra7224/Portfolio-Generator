# Client Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NOTE: CRA only exposes variables prefixed with REACT_APP_ to the browser.
# REACT_APP_GOOGLE_CLIENT_ID is a public OAuth identifier (not a secret).

# Google Sign-In client ID (same value as the server's GOOGLE_CLIENT_ID).
# Get it from Google Cloud Console → APIs & Services → Credentials.
REACT_APP_GOOGLE_CLIENT_ID=

GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=false
