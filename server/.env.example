# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Port
PORT=5000

# Environment (development, production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas dashboard or using Atlas CLI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio-generator?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio-generator?retryWrites=true&w=majority

# JWT Secret for authentication
# Generate a secure one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production: the server refuses to boot without it.
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# CORS: comma-separated origins allowed to call the API cross-origin.
# Leave empty for same-origin-only in production (recommended on Render,
# where the client bundle is served by this same server).
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
# CORS_ORIGIN=

# Google Sign-In (Google Identity Services ID-token flow)
# This is the OAuth 2.0 Client ID (public identifier, NOT a secret).
# The backend verifies Google ID tokens against this audience and then
# issues the app's own JWT — no Google password is ever handled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
